<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.dapr.examples</groupId>
    <artifactId>travel-planner-langchain4j-quarkus</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Travel Planner - LangChain4j + Quarkus + Dapr</name>
    <description>Multi-agent travel planner demonstrating orchestration patterns with LangChain4j, Quarkus, and Dapr Workflows</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.version>3.31.2</quarkus.version>
        <quarkus-dapr.version>2.5.0</quarkus-dapr.version>
        <quarkus-langchain4j.version>1.7.1</quarkus-langchain4j.version>
        <dapr-quarkus-agentic.version>0.1.0-SNAPSHOT</dapr-quarkus-agentic.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Dapr Agentic extension (brings quarkus-dapr + quarkus-langchain4j-agentic transitively) -->
        <dependency>
            <groupId>io.dapr.quarkus</groupId>
            <artifactId>quarkus-agentic-dapr</artifactId>
            <version>${dapr-quarkus-agentic.version}</version>
        </dependency>

        <!-- Agent registry for dapr-agents compatibility -->
        <dependency>
            <groupId>io.dapr.quarkus</groupId>
            <artifactId>quarkus-agentic-dapr-agents-registry</artifactId>
            <version>${dapr-quarkus-agentic.version}</version>
        </dependency>

        <!-- LLM provider: Ollama (direct) -->
        <dependency>
            <groupId>io.quarkiverse.langchain4j</groupId>
            <artifactId>quarkus-langchain4j-ollama</artifactId>
            <version>${quarkus-langchain4j.version}</version>
        </dependency>

        <!-- LLM provider: Dapr Conversation API (provider-agnostic) -->
        <dependency>
            <groupId>io.dapr.quarkus</groupId>
            <artifactId>quarkus-langchain4j-dapr</artifactId>
            <version>${dapr-quarkus-agentic.version}</version>
        </dependency>

        <!-- REST endpoint -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
